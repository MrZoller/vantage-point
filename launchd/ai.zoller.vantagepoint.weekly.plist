<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <!-- Label is filled in by bin/install-launchd.sh (instance-namespaced when set). -->
  <string>__VP_LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Path is filled in by bin/install-launchd.sh; edit this template, not your copy. -->
    <string>__VP_ROOT__/bin/monitor.sh</string>
    <string>weekly</string>
  </array>

  <!-- Monday (Weekday 1) at 07:00. Sunday is 0; 1=Mon ... 6=Sat. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__VP_ROOT__/state/weekly.out.log</string>
  <key>StandardErrorPath</key>
  <string>__VP_ROOT__/state/weekly.err.log</string>
</dict>
</plist>
