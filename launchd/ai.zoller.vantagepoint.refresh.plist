<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <!-- Label is filled in by bin/install-launchd.sh (instance-namespaced when set). -->
  <string>__VP_LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Path is filled in by bin/install-launchd.sh; edit this template, not your copy. -->
    <string>__VP_ROOT__/bin/bootstrap.sh</string>
    <!-- The flag below is self-gating: the run is a no-op unless the approved profile
         is past governance.profile_refresh_days. Firing on a schedule is how a
         forgotten refresh stops being forgotten; the gate is how that costs nothing
         on every day it isn't due. (XML comments cannot contain a double hyphen, which is why
         the flag is named in prose rather than quoted here.) -->
    <string>--if-stale</string>
  </array>

  <!-- DAILY, not monthly. The gate below is a few file reads and a date comparison, so
       polling costs nothing; the expensive part only happens when the window is actually
       crossed. A monthly poll cannot honour the window it is checking: with the default
       profile_refresh_days of 30, a profile refreshed on the 1st is 28 days old at the
       next monthly check, gets skipped, and is ~59 days old by the one after - twice its
       contract. Shorter windows fare worse still (frontier-models uses 7).

       The time is filled in by bin/install-launchd.sh, which hashes the agent label into
       one of 300 slots across 01:00-05:59. Clones bootstrapped on the same day cross
       their windows on the same day, so without an offset they would all start an
       expensive deep-research run at the same instant. All the buckets sit ahead of the
       06:30 daily sweep. Set deployment.refresh_time (HH:MM) to pin a slot instead of
       hashing one, which is the only way to GUARANTEE two instances differ: separate
       checkouts share no state, so nothing can detect a sibling's choice. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>__VP_REFRESH_HOUR__</integer>
    <key>Minute</key><integer>__VP_REFRESH_MINUTE__</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__VP_ROOT__/state/refresh.out.log</string>
  <key>StandardErrorPath</key>
  <string>__VP_ROOT__/state/refresh.err.log</string>
</dict>
</plist>
